<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Postgres embedded server equivalent for .Net applications</Description>
    <Copyright>Copyright (C) Babu Annamalai</Copyright>
    <AssemblyTitle>MysticMind.PostgresEmbed</AssemblyTitle>
    <VersionPrefix>4.1.0</VersionPrefix>
    <Authors>Babu Annamalai</Authors>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>MysticMind.PostgresEmbed</AssemblyName>
    <PackageId>MysticMind.PostgresEmbed</PackageId>
    <PackageTags>postgres;postgresql;pg;embed;embedded;server;.net 4.6;net 4.6;net46;.net core;net core;netcore;netcore 2.0;netcore rtm</PackageTags>
    <PackageProjectUrl>https://github.com/mysticmind/mysticmind-postgresembed</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mysticmind/mysticmind-postgresembed</RepositoryUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>PostgresEmbed</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
</Project>
